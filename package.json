{
  "name": "roster-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest --pool=forks --poolOptions.forks.singleFork",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "db:seed": "ts-node --compiler-options '{\"module\":\"commonjs\"}' src/db/seed.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.12.0",
    "drizzle-orm": "^0.24.0",
    "next": "13.4.10",
    "pg": "^8.11.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.4.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.16",
    "eslint": "8.46.0",
    "eslint-config-next": "13.4.10",
    "typescript": "5.3.3",
    "ts-node": "10.9.1"
    ,
    "vitest": "^1.0.0"
  }
}
